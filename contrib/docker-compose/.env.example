# Copy to .env and fill in. Never commit .env.

# MySQL passwords: letters and digits only (no ';'), e.g. the output of: openssl rand -hex 16
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# IPv4 address players connect to: 127.0.0.1 (this machine only), or the server's address on your network (LAN IP,
# VPN address, public IP).
PUBLIC_IP=127.0.0.1

# Where ports 1119, 8081 and WORLD_PORT are published: 127.0.0.1 (this machine only), one address of this machine (for
# example a VPN address), or 0.0.0.0 (every network; then limit who can connect with a firewall).
PUBLISH_IP=127.0.0.1

# The realm (ruleset) this worldserver runs. Normal: 70 / 8085 / GameType 0 / content set 137 / super district 2.
# PvP: 71 / 8095 / 1 / 136 / 1.   RP: 72 / 8105 / 6 / 138 / 3.   Hardcore: 73 / 8115 / 0 / 140 / 4 (and HARDCORE=1).
# Realms that no worldserver runs should be flagged offline: UPDATE auth.realmlist SET flag = flag | 2 WHERE id IN (...)
REALM_ID=70
WORLD_PORT=8085
GAME_TYPE=0
CONTENT_SET_ID=137
SUPER_DISTRICT_ID=2
HARDCORE=0

# Parallel compile jobs (empty: one per CPU, at most one per 2.5 GB of RAM)
BUILD_JOBS=

# The World of Warcraft folder of the 1.60.1.70450 client (the one that holds .build.info and _classic_beta_). Only the
# extractor reads it.
WOW_DIR=./wow

# Where the extracted game data (dbc, gt, maps, vmaps) is kept.
DATA_DIR=./data

# 1 builds the WoW Forever Bots module into the image (doc/Docker.md, "Bots"); rebuild the image after changing it
BUILD_PLAYERBOT_V2=0

# 1 = creatures (and bots) use the navigation meshes in DATA_DIR/mmaps. Generate them first (doc/Docker.md, "Pathfinding").
MMAP_PATHFINDING=0
