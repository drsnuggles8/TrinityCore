# Optional local worldserver settings: copy to worldserver.env (git-ignored). One TC_* variable per line; the name is the
# config key in upper case with "." and camelCase humps turned into "_" (Playerbot.World.MaxBots = TC_PLAYERBOT_WORLD_MAX_BOTS).
# The values in compose.yaml's environment win over this file. Restart the worldserver after a change; the bot keys are also
# re-read every 15 s.

# Bots (image built with BUILD_PLAYERBOT_V2=1): a crowded leveling zone for launch practice. Bots appear around each real player
# at the player's level and quest and fight on their own; the defaults (zz-forever-bots.conf in the image) are 220 bots awake,
# 60 in a leveling zone, a sleeping roster of 3000.
TC_PLAYERBOT_WORLD_ENABLE=1
TC_PLAYERBOT_WORLD_FRIENDLY_PCT=100
TC_PLAYERBOT_WORLD_MAX_BOTS=150
TC_PLAYERBOT_WORLD_ZONE_BOTS=60
TC_PLAYERBOT_WORLD_POOL_MAX=1000
# Launch-night crowd all day instead of the server-hour rhythm (60% at night, 125% in the evening)
TC_PLAYERBOT_WORLD_DAY_RHYTHM=0
# Stop adding bots once the worldserver uses this much memory (MB)
TC_PLAYERBOT_WORLD_RSS_BUDGET_MB=9000
